{
  "name": "dsh-god-view-repo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test -w godview && npm run test -w dsh-god-view",
    "host:smoke": "npm run host:smoke -w dsh-god-view",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "adr:validate": "adrkit validate --all",
    "check": "npm run format:check && npm run lint && npm test && npm run host:smoke && npm run adr:validate",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "adr-kit": "^0.32.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
