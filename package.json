{
  "name": "dsh-god-view",
  "version": "0.3.0",
  "description": "Give your agents a god's eye view: file leases, claim and release records, and a Gantt of who holds what, so parallel agents stop overwriting each other. A DSH plugin, on by default, one switch turns it off.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./store": "./lib/store.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-god-view": "./bin/dsh-god-view.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib/",
    "bin/",
    "docs/",
    "adr/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "adr:validate": "adrkit validate --all",
    "check": "npm run format:check && npm run lint && npm test && node test/host-smoke.mjs && npm run adr:validate",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "multi-agent",
    "coordination",
    "file-lease"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "adr-kit": "^0.32.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/luochang212/dsh-god-view.git"
  },
  "homepage": "https://github.com/luochang212/dsh-god-view#readme",
  "bugs": {
    "url": "https://github.com/luochang212/dsh-god-view/issues"
  }
}
